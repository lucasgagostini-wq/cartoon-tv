# Perfil do Chrome logado no HBO Max — contém Login Data, Cookies e Local State.
# NUNCA versionar: é credencial de sessão da conta.
televisor/.chrome-profile/
televisor/.chrome-controle/

# Preferências e estado de runtime — cada instalação tem os seus
televisor/preferencias.json
televisor/configuracao.json
televisor/tv-log.txt

# Screenshots de diagnóstico — capturam a tela do Max logado (nome do perfil aparece)
televisor/*.png

# Grade gerada (determinística: reconstruída por `node emissora/gerar-grade.js`)
emissora/grade/

node_modules/

# Saída do empacotamento — o instalador vai como anexo da Release, não no repo
dist/
instalador/staging/
